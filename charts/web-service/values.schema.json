{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "web-service values",
  "type": "object",
  "required": [
    "image",
    "service"
  ],
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "description": "Image name. Empty is allowed here only because values.yaml ships a placeholder; the template fails at render if it is still empty.",
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "extraLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "description": "Container port. Must be >= 1024: binding lower needs CAP_NET_BIND_SERVICE, which the chart drops.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ]
        }
      }
    },
    "env": {
      "description": "A plain map, or the Kubernetes list form for secretKeyRef/fieldRef.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9*]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "matches": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "backendRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "port"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "weight": {
                      "type": "integer"
                    }
                  }
                }
              },
              "timeouts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "type": "string",
                    "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"
                  },
                  "backendRequest": {
                    "type": "string",
                    "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "readinessProbe": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "preStopSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceList"
        },
        "limits": {
          "$ref": "#/definitions/resourceList"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ]
        },
        "targetMemoryUtilizationPercentage": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "writableDirs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "volumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "migrate": {
      "description": "Schema migrations as a pre-install/pre-upgrade Helm hook. The image carries the tool and the migration files and is tagged with the application, so `tag` defaults to `image.tag`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "description": "Falls back to image.registry.",
              "type": "string"
            },
            "repository": {
              "description": "Required when enabled; the template fails at render otherwise.",
              "type": "string"
            },
            "tag": {
              "description": "Falls back to image.tag, which is what keeps schema and code in lockstep. Set it only to deliberately decouple them.",
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never",
                ""
              ]
            }
          }
        },
        "command": {
          "type": "array"
        },
        "args": {
          "type": "array"
        },
        "env": {
          "type": "array"
        },
        "envFrom": {
          "description": "Falls back to the application's envFrom - the same database credentials.",
          "type": "array"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "writableDirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "volumes": {
          "type": "array"
        },
        "volumeMounts": {
          "type": "array"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "$ref": "#/definitions/resourceList"
            },
            "limits": {
              "$ref": "#/definitions/resourceList"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^[0-9]+m?$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$"
        },
        "ephemeral-storage": {
          "type": "string"
        }
      }
    }
  }
}
